# 이 파일을 application-private.yml로 복사한 뒤 개인 설정을 입력합니다.
# application-private.yml은 git에 올라가지 않도록 .gitignore에 등록되어 있습니다.

db:
  url: jdbc:mysql://localhost:3306/miso-blog?useSSL=false&allowPublicKeyRetrieval=true&useUnicode=true&serverTimezone=Asia/Seoul
  username: root
  password: 1234

rabbitmq:
  host: localhost
  port: 5672
  username: guest
  password: guest

openai:
  api-key:
  admin-key:
  model: gpt-4.1-mini
  budget-limit-usd:

github:
  # GitHub Pages 발행까지 사용하려면 contents write 권한이 필요합니다.
  token:
