# 이 파일을 application-private.yml로 복사한 뒤 개인 설정을 입력합니다.
# application-private.yml은 git에 올라가지 않도록 .gitignore에 등록되어 있습니다.

db:
  url: jdbc:mysql://localhost:3306/miso-blog?useSSL=false&allowPublicKeyRetrieval=true&useUnicode=true&serverTimezone=Asia/Seoul
  username: root
  password: 1234

openai:
  api-key:
  admin-key:
  model: gpt-4.1-mini
  budget-limit-usd:

github:
  # GitHub Pages 발행까지 사용하려면 contents write 권한이 필요합니다.
  token:
  # repositoryFullName을 DB에 넣지 않아도 아래 값으로 GitHub Pages 대상을 추론할 수 있습니다.
  # owner만 입력하면 owner/owner.github.io 저장소를 기본값으로 사용합니다.
  # project Pages 저장소를 고정하려면 pages-repository-full-name: MiSo-13/tech-blog 처럼 입력합니다.
  # 이 경우 pages-base-url을 비워도 서버가 https://miso-13.github.io/tech-blog 형태로 추론합니다.
  owner:
  pages-repository-name:
  pages-repository-full-name:
  pages-branch: main
  pages-content-root-path: _posts
  pages-base-url:
  pages-custom-domain:
  analysis:
    # analyzeAllCommits=true일 때 최대 몇 개 commit까지 훑을지 제한합니다.
    max-all-commits: 300

naver:
  # 네이버 블로그 검색 API Client ID/Secret입니다.
  # 일반 블로그 초안/품질 리뷰에서 카테고리와 키워드 기반 상위 블로그 글을 참고할 때 사용합니다.
  client-id:
  client-secret:
  blog-search-enabled: true
  # 네이버 공식 API의 display는 최대 100이지만, AI 컨텍스트 비용을 줄이기 위해 서버에서는 최대 10개로 제한합니다.
  blog-search-display: 5
  # sim: 정확도순, date: 날짜순
  blog-search-sort: sim
  # 검색 결과 중 실제 본문 확인을 시도할 상위 개수입니다.
  blog-search-content-fetch-limit: 3

blog:
  local-repositories:
    # Docker 배포에서는 GitHub에서 선택한 저장소가 이 경로 아래로 clone됩니다.
    # 컨테이너 내부 경로이므로 Windows의 C:\ 경로를 넣지 않습니다.
    clone-base-dir: /app/repositories
    defaults:
      # 프론트에서 바로 선택할 수 있는 로컬 Git 저장소 후보입니다.
      - name: magi-platform
        local-path: C:\pjt\magi-platform
        default-branch: main
        description: MAGI 참고 프로젝트
        active: true
