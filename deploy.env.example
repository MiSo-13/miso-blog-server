MISO_BLOG_PORT=8010
MISO_BLOG_NETWORK_NAME=miso-blog-network

DB_URL=jdbc:mysql://host.docker.internal:3306/miso-blog?useSSL=false&allowPublicKeyRetrieval=true&useUnicode=true&serverTimezone=Asia/Seoul
DB_USERNAME=root
DB_PASSWORD=change-me

RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BUDGET_LIMIT_USD=

GITHUB_TOKEN=
GITHUB_OWNER=

BLOG_PUBLIC_BASE_URL=http://localhost:8010
BLOG_MEDIA_UPLOAD_DIR=/data/miso-blog/uploads
BLOG_MEDIA_PUBLIC_URL_PREFIX=/media
BLOG_MEDIA_MAX_FILE_SIZE=10MB
BLOG_MEDIA_MAX_REQUEST_SIZE=30MB
BLOG_MEDIA_MAX_FILE_SIZE_BYTES=10485760

# Windows 로컬 배포 예시입니다. Linux 서버에서는 /srv/miso-blog/uploads 같은 경로로 바꾸세요.
MISO_BLOG_UPLOAD_ROOT=C:/pjt/miso-blog-server/uploads
MISO_BLOG_LOCAL_PROJECTS_ROOT=C:/pjt
MISO_BLOG_JAVA_OPTS=-Xms256m -Xmx512m
